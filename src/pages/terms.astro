---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Terms &amp; Conditions">
  <article class="wrap" style="max-width: 720px; padding: 56px var(--gutter) 80px;">
    <h1 style="font-size: 2rem; margin-bottom: 24px;">Terms &amp; Conditions</h1>
    <div class="post-body">
      <p>Add your studio's actual terms here — cancellation policy, payment methods, age requirements, and anything else you want visitors to see before booking.</p>
    </div>
  </article>
</BaseLayout>
