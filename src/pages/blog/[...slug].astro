---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('./*.md', { eager: true });
  return Object.entries(postFiles).map(([path, post]) => ({
    params: { slug: path.replace('./', '').replace('.md', '') },
    props: { frontmatter: post.frontmatter },
  }));
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <div class="post-body">
    <a href="/" class="back-link">← All posts</a>

    {frontmatter.tag && (
      <p class="post-tag">{frontmatter.tag}</p>
    )}

    <h1>{frontmatter.title}</h1>

    <div class="post-meta">
      <span>{frontmatter.date}</span>
      {frontmatter.readTime && <span>{frontmatter.readTime}</span>}
    </div>

    <div class="post-content">
      <slot />
    </div>
  </div>
</BaseLayout>