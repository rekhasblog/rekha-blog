---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="wrap" style="max-width: 720px; padding: 56px var(--gutter) 80px;">
    <div class="post-header">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
      </time>
      <h1>{post.data.title}</h1>
    </div>
    <div class="post-body">
      <Content />
    </div>
    <a href="/blog" class="btn btn-outline" style="margin-top: 24px;">← Back to all posts</a>
  </article>
</BaseLayout>
