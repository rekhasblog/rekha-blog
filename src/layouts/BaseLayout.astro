---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Tarot and cardology readings that help you hear your own intuition.",
} = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Offerings', href: '/offerings' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&family=Space+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>

    <header class="site-header">
      <div class="site-header__bar wrap">
        <button
          class="menu-toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </button>

        <a class="logo" href="/" aria-label="Rekha's Reflections — home">
          <img src="/images/header.png" alt="Rekha's Reflections mirror mark" width="70" height="113" />
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            {navItems.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <nav id="mobile-nav" class="mobile-nav" aria-label="Primary, mobile">
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <img class="footer-logo" src="/images/footer.png" alt="Rekha's Reflections monogram" width="64" height="62" />

        <a class="back-to-top" href="#top">
          <span class="back-to-top__arrow" aria-hidden="true">&#8593;</span>
          Back to top
        </a>

        <div class="footer-legal">
          <a href="/terms">Terms &amp; Conditions</a>
          <span class="footer-legal__divider" aria-hidden="true">&middot;</span>
          <span>&copy; 2026 Rekha's Reflections</span>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');

      const closeMenu = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open menu');
        mobileNav?.classList.remove('is-open');
        document.body.classList.remove('menu-open');
      };

      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
        mobileNav?.classList.toggle('is-open', !isOpen);
        document.body.classList.toggle('menu-open', !isOpen);
      });

      mobileNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--parchment);
        color: var(--ink);
        padding: 0.75rem 1.25rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      /* ---------- Header ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(239, 230, 221, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }

      /* 3 equal-ish columns: left spacer/menu-toggle, centered logo, right-aligned nav */
      .site-header__bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding-block: 0.9rem;
      }

      .logo {
        grid-column: 2;
        justify-self: center;
      }

      .logo img {
        display: block;
      }

      .site-nav {
        grid-column: 3;
        justify-self: end;
      }

      .site-nav ul {
        list-style: none;
        display: flex;
        gap: clamp(1.1rem, 2vw, 1.8rem);
        margin: 0;
        padding: 0;
      }

      .site-nav a {
        text-decoration: none;
        font-size: 0.92rem;
        letter-spacing: 0.02em;
        color: var(--rose);
        position: relative;
        padding-block: 0.2rem;
      }

      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--parchment);
      }

      .site-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1px;
        background: var(--rose);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
      }

      .site-nav a:hover::after,
      .site-nav a:focus-visible::after {
        transform: scaleX(1);
      }

      .menu-toggle {
        display: none;
        grid-column: 1;
        justify-self: start;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
      }

      .menu-toggle__bar {
        width: 22px;
        height: 2px;
        background: var(--parchment);
        display: block;
      }

      .mobile-nav {
        display: none;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        border-top: 1px solid var(--line);
      }

      .mobile-nav ul {
        list-style: none;
        margin: 0;
        padding: 1rem var(--gutter) 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }

      .mobile-nav a {
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 1.2rem;
        color: var(--rose);
      }

      .mobile-nav.is-open {
        max-height: 20rem;
      }

      @media (max-width: 720px) {
        .site-nav {
          display: none;
        }
        .menu-toggle {
          display: flex;
        }
        .mobile-nav {
          display: block;
        }
      }

      /* ---------- Footer ---------- */
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: clamp(3rem, 8vw, 6rem);
        padding-block: clamp(2.5rem, 6vw, 3.5rem);
      }

      .site-footer__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.4rem;
        text-align: center;
      }

      .footer-logo {
        margin-inline: auto;
      }

      .back-to-top {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-family: var(--font-label);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--rose);
      }

      .back-to-top__arrow {
        display: inline-block;
        transition: transform 0.2s ease;
      }

      .back-to-top:hover .back-to-top__arrow {
        transform: translateY(-3px);
      }

      .social-links {
        list-style: none;
        display: flex;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
      }

      .social-links a {
        color: var(--rose);
        display: inline-flex;
      }

      .social-links a:hover,
      .social-links a:focus-visible {
        color: var(--parchment);
      }

      .footer-legal {
        font-size: 0.82rem;
        color: var(--rose);
      }

      .footer-legal a {
        color: var(--rose);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .footer-legal a:hover {
        color: var(--parchment);
      }

      .footer-legal__divider {
        margin-inline: 0.5rem;
      }
    </style>
  </body>
</html>